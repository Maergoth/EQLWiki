{
  "name": "EQLZoneViewer",
  "version": "1.15.0",
  "author": [
    "EverQuest Legends Wiki"
  ],
  "url": "https://eqlwiki.com/Special:ZoneViewer",
  "descriptionmsg": "eqlzoneviewer-desc",
  "license-name": "GPL-2.0-or-later",
  "type": "other",
  "requires": {
    "MediaWiki": ">= 1.43",
    "platform": {
      "php": ">= 8.1"
    }
  },
  "AutoloadNamespaces": {
    "EQLWiki\\ZoneViewer\\": "src/"
  },
  "SpecialPages": {
    "ZoneViewer": "EQLWiki\\ZoneViewer\\SpecialZoneViewer"
  },
  "Hooks": {
    "ParserFirstCallInit": "EQLWiki\\ZoneViewer\\Hooks::onParserFirstCallInit"
  },
  "ResourceModules": {
    "ext.eqlZoneViewer": {
      "scripts": [
        "resources/ext.eqlZoneViewer.bootstrap.js"
      ],
      "styles": [
        "resources/ext.eqlZoneViewer.css"
      ],
      "dependencies": [
        "mediawiki.util"
      ],
      "localBasePath": "",
      "remoteExtPath": "EQLZoneViewer"
    }
  },
  "MessagesDirs": {
    "EQLZoneViewer": [
      "i18n"
    ]
  },
  "ExtensionMessagesFiles": {
    "EQLZoneViewerAlias": "EQLZoneViewer.alias.php"
  },
  "config": {
    "EQLZoneViewerDefaultHeight": {
      "value": 780,
      "description": "Default embedded viewer height in CSS pixels."
    }
  },
  "manifest_version": 2
}
