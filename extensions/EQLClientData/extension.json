{
  "name": "EQLClientData",
  "version": "1.2.0",
  "author": "EverQuest Legends Wiki",
  "description": "Provides revision-aware client metadata and optional authenticated, idempotent gameplay observations.",
  "type": "other",
  "license-name": "GPL-2.0-or-later",
  "requires": {
    "MediaWiki": ">= 1.45"
  },
  "AutoloadNamespaces": {
    "EQLClientData\\": "includes/"
  },
  "ServiceWiringFiles": [
    "includes/ServiceWiring.php"
  ],
  "MessagesDirs": { "EQLClientData": [ "i18n" ] },
  "AvailableRights": [ "eoz-submit-observations" ],
  "GroupPermissions": { "user": { "eoz-submit-observations": true } },
  "GrantPermissions": { "eozobservations": { "eoz-submit-observations": true } },
  "APIModules": {
    "eqlcharactereffects": { "class": "EQLClientData\\ApiCharacterEffects" },
    "eqlplayers": {
      "class": "EQLClientData\\ApiPlayers",
      "services": [ "EQLClientData.PlayerListRepository" ]
    },
    "eozobservations": {
      "class": "EQLClientData\\ApiObservations",
      "services": [ "EQLClientData.ObservationRepository", "MainConfig" ]
    },
    "eqlmetadata": {
      "class": "EQLClientData\\ApiMetadata",
      "services": [
        "EQLClientData.ConfigRepository",
        "MainConfig",
        "TitleFactory"
      ]
    }
  },
  "HookHandlers": {
    "main": {
      "class": "EQLClientData\\Hooks",
      "services": [
        "EQLClientData.ConfigRepository",
        "MainConfig"
      ]
    }
  },
  "Hooks": {
    "LoadExtensionSchemaUpdates": "EQLClientData\\SchemaHooks::onLoadExtensionSchemaUpdates",
    "BeforePageDisplay": "main",
    "PageSaveComplete": "main",
    "PageDeleteComplete": "main",
    "PageMoveComplete": "main"
  },
  "config": {
    "EQLClientDataPlayerMaxLevel": { "value": 50 },
    "EQLClientDataEnableObservations": { "value": false },
    "EQLClientDataObservationRequireConfirmedEmail": { "value": true },
    "EQLClientDataObservationHourlyBatches": { "value": 12 },
    "EQLClientDataObservationMaxEvents": { "value": 100000 },
    "EQLClientDataObservationActorMaxEvents": { "value": 10000 },
    "EQLClientDataObservationMaxBatches": { "value": 20000 },
    "EQLClientDataObservationActorMaxBatches": { "value": 2000 },
    "EQLClientDataEnableEra": {
      "value": false
    },
    "EQLClientDataEnableVerification": {
      "value": false
    },
    "EQLClientDataEnableSpellOverrides": {
      "value": false
    },
    "EQLClientDataVerificationModuleName": {
      "value": ""
    },
    "EQLClientDataVerifiedPagesTitle": {
      "value": "VerifiedPages"
    },
    "EQLClientDataPageEraTitle": {
      "value": "Template:PageEra"
    },
    "EQLClientDataSpellOverridesTitle": {
      "value": "SpellLevelSliderOverrides"
    },
    "EQLClientDataEraStatusClientTtlSeconds": {
      "value": 30
    },
    "EQLClientDataApiMaxTitles": {
      "value": 500
    }
  },
  "manifest_version": 2
}
