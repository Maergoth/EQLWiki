# Installed outside the document root and prepended to each staging release.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^test\.eqlwiki\.com(?::(?:80|443))?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{THE_REQUEST} \s(/[^\s?]*)
RewriteRule ^ https://test.eqlwiki.com%1 [R=308,L,NE]

AuthType Basic
AuthName "EQLWiki Staging"
AuthUserFile /home/eqlwikdq/.htpasswds/test.eqlwiki.com/passwd
SetEnvIf Request_URI "^/staging-access[.]php([?]|$)" EQL_STAGING_ALLOW=1
SetEnvIf Request_URI "^/[.]well-known/acme-challenge/" EQL_STAGING_ALLOW=1
# EQL_STAGING_TOKEN_ALLOWLIST
Order deny,allow
Deny from all
Allow from env=EQL_STAGING_ALLOW
Require valid-user
Satisfy any
ErrorDocument 401 /staging-access.php
Header always unset WWW-Authenticate
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
