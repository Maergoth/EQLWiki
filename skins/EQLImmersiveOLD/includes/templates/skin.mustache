	{{#data-main-menu}}{{>MainMenu}}{{/data-main-menu}}
</div>

<div id="eql-user-menu-host" aria-label="{{msg-personaltools}}" style="display: none;"></div>

<script>
(function () {
	var host = document.getElementById( 'eql-main-menu-host' );
	var isPinned = document.documentElement.classList.contains( 'eql-main-menu-pinned-initial' );

	if ( host && isPinned ) {
		host.style.display = 'block';
	}

	if ( isPinned && document.body ) {
		document.body.classList.add(
			'eql-main-menu-js',
			'eql-main-menu-open',
			'eql-main-menu-pinned'
		);
	}
}());
</script>

