{{!
	string|null html-site-notice the contents of a banner defined in MediaWiki:Sitenotice.
		Also used by CentralNotice to inject banners into Vector.
	Indicator[] array-indicators wiki-defined badges such as "good article",
		"featured article". An empty array if none are defined.
	string|null html-title
	bool is-article
	string msg-tagline
	string html-subtitle
	string html-undelete-link
	string html-newtalk
	string msg-vector-jumptonavigation
	string msg-vector-jumptosearch
	string msg-vector-jumptocontent
	string html-body-content
	string html-categories
	string html-after-content
	LogoOptions data-logos
	object data-portlets
	MenuDefinition data-portlets.data-personal
	MenuDefinition data-portlets.data-namespaces
	MenuDefinition data-portlets.data-variants
	MenuDefinition data-portlets.data-views
	MenuDefinition data-portlets.data-actions
	object data-search-box. See SearchBox.mustache for documentation.
	string msg-vector-action-toggle-sidebar The label used by the sidebar button.
	string msg-vector-main-menu-tooltip The title attribute for the main menu icon.
	object data-main-menu. See MainMenu.mustache for documentation.
	object data-footer for footer template partial. see Footer.mustache for documentation.
}}

<script>
(function () {
	'use strict';

	function addHtmlClass( className ) {
		if ( className && document.documentElement ) {
			document.documentElement.className += ' ' + className;
		}
	}

	function normalizeEraMode( mode ) {
		mode = String( mode || '' ).toLowerCase();

		if ( mode === 'disabled' || mode === 'disable' || mode === 'false' || mode === '0' ) {
			return 'off';
		}

		if ( mode === 'enabled' || mode === 'enable' || mode === 'true' || mode === '1' ) {
			return 'on';
		}

		if ( mode === 'outline' ) {
			return 'outline';
		}

		if ( mode === 'off' || mode === 'on' ) {
			return mode;
		}

		return '';
	}

	function getStoredEraMode() {
		var mode = '';

		try {
			/*
			 * Current three-state era-filter.js should use one of these.
			 * Keep all likely keys here so the no-pop placeholder survives
			 * small key-name changes and older browser state.
			 */
			mode =
				normalizeEraMode( window.localStorage.getItem( 'eql-era-filter-mode-v1' ) ) ||
				normalizeEraMode( window.localStorage.getItem( 'eql-era-filter-mode' ) ) ||
				normalizeEraMode( window.localStorage.getItem( 'eql-era-filter-state-v1' ) ) ||
				normalizeEraMode( window.localStorage.getItem( 'eql-era-filter-state' ) );

			if ( mode ) {
				return mode;
			}

			/*
			 * Legacy two-state key:
			 *   missing / anything except "0" = On
			 *   "0" = Off
			 */
			if ( window.localStorage.getItem( 'eql-era-filter-enabled-v1' ) === '0' ) {
				return 'off';
			}

			return 'on';
		} catch ( e ) {
			return 'on';
		}
	}

	try {
		window.localStorage.removeItem( 'eqlimmersive-main-menu-pinned' );
		window.localStorage.removeItem( 'eqlimmersive-main-menu-pinned-v2' );
		window.localStorage.removeItem( 'eqlimmersive-main-menu-pinned-v3' );
		window.localStorage.removeItem( 'eqlimmersive-main-menu-pinned-v4' );

		if ( window.localStorage.getItem( 'eqlimmersive-main-menu-pinned-v5' ) === '1' ) {
			addHtmlClass( 'eql-main-menu-pinned-initial' );
		}

		if ( window.localStorage.getItem( 'eql-announcements-collapsed-v1' ) === '1' ) {
			addHtmlClass( 'eql-announcements-collapsed-initial' );
		}

		var eraMode = getStoredEraMode();

		addHtmlClass( 'eql-era-filter-preload-' + eraMode );
		addHtmlClass( 'eql-era-filter-' + eraMode + '-initial' );

		/*
		 * Backward compatibility for older CSS/JS that still checks
		 * enabled/disabled initial classes.
		 */
		if ( eraMode === 'off' ) {
			addHtmlClass( 'eql-era-filter-disabled-initial' );
		} else {
			addHtmlClass( 'eql-era-filter-enabled-initial' );
		}

		document.documentElement.setAttribute( 'data-eql-era-filter-mode', eraMode );
	} catch ( e ) {
		addHtmlClass( 'eql-era-filter-preload-on' );
		addHtmlClass( 'eql-era-filter-on-initial' );
		addHtmlClass( 'eql-era-filter-enabled-initial' );
	}
}());
</script>

